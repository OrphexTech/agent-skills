{
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseVersion",
    "repository",
    "sourceSha",
    "installerVersion",
    "skills",
    "bundles"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "repository": {
      "const": "https://github.com/OrphexTech/agent-skills"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "installerVersion": {
      "const": "1.7.0"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "description",
          "outcome",
          "category",
          "tags",
          "updatedAt",
          "requirements",
          "relatedSkills",
          "platforms",
          "businessTypes",
          "useWhen",
          "inputs",
          "example",
          "agents",
          "version",
          "license",
          "sourcePath",
          "contentHash",
          "instructions",
          "resources",
          "download"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^orphex-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 63
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "reporting-diagnostics",
              "campaign-optimization",
              "creative-messaging",
              "budget-growth",
              "measurement-data-quality",
              "conversion-experiments"
            ]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
            "pattern": "\\S"
            }
          },
          "relatedSkills": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^orphex-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 63
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "google-ads",
                "meta-ads",
                "ga4",
                "merchant-center",
                "crm",
                "platform-agnostic"
              ]
            }
          },
          "businessTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "ecommerce",
                "lead-generation",
                "saas"
              ]
            }
          },
          "useWhen": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "description",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
            "pattern": "\\S"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "example": {
            "type": "object",
            "required": [
              "request",
              "inputCsv",
              "outputMarkdown"
            ],
            "additionalProperties": false,
            "properties": {
              "request": {
                "type": "string",
                "minLength": 1,
            "pattern": "\\S"
              },
              "inputCsv": {
                "type": "string",
                "minLength": 1,
            "pattern": "\\S"
              },
              "outputMarkdown": {
                "type": "string",
                "minLength": 1,
            "pattern": "\\S"
              }
            }
          },
          "agents": {
            "const": [
              "codex",
              "claude-code"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "license": {
            "const": "MIT"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^skills/orphex-[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "resources": {
            "type": "array",
            "minItems": 5,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "path",
                "kind",
                "contentHash"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "enum": [
                    "assets/input-template.csv",
                    "assets/example-input.csv",
                    "references/input-contract.md",
                    "references/business-context.md",
                    "references/example-output.md",
                    "scripts/marketing_math.py"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "template",
                    "example",
                    "reference",
                    "calculator"
                  ]
                },
                "contentHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "download": {
            "type": "object",
            "required": [
              "url",
              "sha256",
              "size"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://github\\.com/OrphexTech/agent-skills/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?/orphex-[a-z0-9]+(?:-[a-z0-9]+)*\\.zip$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "bundles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "skills",
          "request"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "weekly-account-review",
              "search-optimization",
              "experiment-cycle"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^orphex-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 63
            }
          },
          "request": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OrphexTech/agent-skills/blob/main/schemas/catalog.schema.json",
  "title": "Orphex Agent Skills catalog v2"
}
